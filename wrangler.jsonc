{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puzzles",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // The app itself (HTML/JS/CSS) comes from Cloudflare's asset store. The Worker runs
  // first so it can forward the old workers.dev address and answer /api/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Puzzle progress (one row per puzzle).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "puzzle-table",
      "database_id": "ed92127c-97a2-40c0-bf32-e94575fd7df7"
    }
  ],

  // Puzzle photos.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "puzzle-table-photos"
    }
  ],

  // Public sign-in identifiers (not secrets): Apple's Services ID (website) and bundle ID
  // (iPhone app), and Google's web and iOS OAuth client IDs.
  "vars": {
    "APPLE_SERVICES_ID": "app.poozles.web",
    "APPLE_BUNDLE_ID": "app.poozles",
    "APPLE_TEAM_ID": "4J889SV3P4",
    "GOOGLE_WEB_CLIENT_ID": "392796332509-c9aqbkht9frsu9kb27p7bm74095a8146.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_ID": "392796332509-jvs3enrad2n3llj3qa8ki6jug9jns5hb.apps.googleusercontent.com"
  },

  // One live room per shared puzzle (worker/room.js), for playing together.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PuzzleRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PuzzleRoom"] }],

  "routes": [{ "pattern": "poozles.app", "custom_domain": true }],
  "workers_dev": true,
  // No per-version preview URLs: one address.
  "preview_urls": false,
  "observability": { "enabled": true }
}
