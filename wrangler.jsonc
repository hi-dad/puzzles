{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puzzles",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // The app itself (HTML/JS/CSS) is served straight from Cloudflare's asset store;
  // only /api/* runs the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Puzzle progress (one row per puzzle).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "puzzle-table",
      "database_id": "ed92127c-97a2-40c0-bf32-e94575fd7df7"
    }
  ],

  // Puzzle photos.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "puzzle-table-photos"
    }
  ],

  // Cloudflare Access: who may sign in is set in the dashboard (Worker → Access). These
  // public identifiers let the Worker check that each request's signed login token was
  // issued by this account's Access for this app.
  "vars": {
    "TEAM_DOMAIN": "https://old-cloud-6825.cloudflareaccess.com",
    "POLICY_AUD": "d1a1dae14b62d6fd2d76414fadc2706d787a7dac94dca8d844bbf78a361ef0dc"
  },

  "workers_dev": true,
  // No per-version preview URLs: one address, protected by Access.
  "preview_urls": false,
  "observability": { "enabled": true },

  // Pretend-login for `wrangler dev` on your own computer.
  "access": {
    "dev": {
      "aud": "local-dev",
      "identity": { "email": "dev@example.com" }
    }
  }
}
